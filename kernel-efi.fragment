# UEFI で実機起動する版（build-efi.sh）で kernel.fragment に足すもの。
# kernel.fragment で無効にしたもの（!VT など）もここで有効にし直せる（こちらが優先）
ACPI                  # EFI の前提。電源断（poweroff）もできるようになる
EFI                   # UEFI のランタイムサービス
EFI_STUB              # bzImage を UEFI から直接起動できる実行ファイル（PE）にする。ブートローダ不要
CMDLINE_BOOL          # 起動オプションをカーネルに埋め込む（UEFI から直接起動すると誰も渡してくれない）

# 画面: UEFI が用意した画面（GOP）に文字を出す
VT                    # 仮想コンソール（tty1〜）
VT_CONSOLE            # カーネルのメッセージを画面にも出す
FB                    # フレームバッファ
FB_EFI                # UEFI の画面をフレームバッファとして使う（efifb）
FRAMEBUFFER_CONSOLE   # フレームバッファの上に文字コンソールを載せる（fbcon）

# キーボード: USB（今の PC の大半）と PS/2（ノート PC の内蔵キーボードに多い）
INPUT                 # 入力デバイス層
INPUT_KEYBOARD
USB_SUPPORT
USB                   # USB の基本
USB_PCI
USB_XHCI_HCD          # USB 3 のホストコントローラ（今の PC はほぼこれ）
HID_SUPPORT
HID
HID_GENERIC
USB_HID               # USB キーボード
SERIO                 # PS/2
SERIO_I8042
KEYBOARD_ATKBD        # PS/2 キーボード

# 起動した USB メモリ（FAT）にデータも保存する
SCSI                  # USB メモリは SCSI ディスクとして見える
BLK_DEV_SD            # SCSI ディスク（/dev/sda）
USB_STORAGE           # USB メモリ
MSDOS_PARTITION       # パーティション表（MBR）
EFI_PARTITION         # パーティション表（GPT）
FAT_FS
VFAT_FS               # FAT（UEFI の起動パーティションの形式）
NLS_CODEPAGE_437      # FAT のファイル名の文字コード
NLS_ISO8859_1
